# Local development uses the Laravel API served by Herd.
VITE_API=http://Elmullim-b.test
VITE_ENV=local
# Optional fallback only. Production Pusher config should be managed from Admin > External Integrations.
# The frontend fetches the active public Pusher config from the backend at runtime.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_CLUSTER=mt1

# Production deployment should override VITE_API with the production API URL
# and set VITE_ENV=production in the deployment environment.
